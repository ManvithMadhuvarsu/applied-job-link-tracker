{
  "manifest_version": 3,
  "name": "Job Application Link Saver",
  "version": "0.1.0",
  "description": "Automatically saves direct links to job posts after an application appears to be submitted.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Saved job applications",
    "default_popup": "popup/popup.html"
  }
}
