{
  "manifest_version": 3,
  "name": "Job Application Link Saver",
  "version": "0.1.1",
  "description": "Automatically saves direct links to job posts after an application appears to be submitted.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://inbox.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://app.fastmail.com/*",
        "https://mail.zoho.com/*",
        "https://mail.aol.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://github.com/*",
        "https://stackoverflow.com/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Saved job applications",
    "default_popup": "popup/popup.html"
  }
}
